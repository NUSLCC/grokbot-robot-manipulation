# Hardware profile: second workstation - 1x RTX 4090 24 GB (Ada, sm_89), native Ubuntu 22.04 (not WSL),
# NVIDIA driver 595, 64 GB RAM. Uses the same torch/CUDA choices as PR #1.
# Auto-selected when the first GPU name contains "4090". Override with PROFILE=<name>. Any variable you export wins.
: "${RSP_PROFILE_DESC:=1x RTX 4090 24 GB (Ada sm_89), native Ubuntu 22.04, driver 595, 64 GB RAM}"
: "${RSP_EXPECT_GPUS:=1}"
: "${RSP_VRAM_CLASS_GB:=24}"
: "${RSP_GPU_ARCH:=ada}"
: "${TORCH_CUDA:=cu128}"                 # PR #1 choice (LeRobot/ManiSkill cu128); other frameworks keep their own pins
: "${RSP_WSL_RENDER_FALLBACK:=1}"
: "${RSP_PI0_LORA_NOTE:=tight: openpi README says LoRA needs > 22.5 GB on a 24 GB card}"
: "${RSP_EXPECT_WSL:=0}"                 # native Linux path (00_check_system.sh warns if WSL is detected)
