# Hardware profile: Windows 11 LAPTOP - RTX 5090 Laptop GPU 24 GB (Blackwell, sm_120), WSL2 Ubuntu 24.04,
# NVIDIA Windows driver 596.36 (WSL2 uses the Windows driver; never install a Linux NVIDIA driver inside WSL).
# Auto-selected when the first GPU name contains "5090" and "Laptop". Override with PROFILE=<name>.
# Any variable you export before running a script wins over these values.
#
# Blackwell needs PyTorch built for CUDA >= 12.8 (torch >= 2.7, cu128 wheels) in EVERY framework env.
# Frameworks that pin an older torch (OpenVLA-OFT torch 2.2, SimpleVLA-RL torch 2.4, openpi's Python-3.8 LIBERO
# client torch 1.11) have no sm_120 kernels; the installers warn about this. Isaac Lab 3.0 (torch 2.11 cu130) is fine.
#
# Laptop notes: plug in the charger and set Windows power mode to "Best performance"; a laptop GPU has lower
# sustained clocks and throttles when hot, so expect runs to be slower than a desktop 24 GB card.
# Keep .wslconfig memory at most ~75% of the laptop's RAM so Windows stays responsive (see docs/WSL2.md).
: "${RSP_PROFILE_DESC:=RTX 5090 Laptop GPU 24 GB (Blackwell sm_120), WSL2 Ubuntu 24.04, Windows driver 596.36}"
: "${RSP_EXPECT_GPUS:=1}"
: "${RSP_VRAM_CLASS_GB:=24}"
: "${RSP_GPU_ARCH:=blackwell}"
: "${TORCH_CUDA:=cu128}"
: "${RSP_MIN_NVCC_BLACKWELL:=12.8}"      # flash-attn / CUDA extension builds need nvcc >= 12.8 for sm_120
: "${RSP_WSL_RENDER_FALLBACK:=1}"        # MuJoCo EGL -> OSMesa, SAPIEN Vulkan -> state-only / skip
: "${RSP_IS_LAPTOP:=1}"
: "${RSP_PI0_LORA_NOTE:=tight: openpi README says LoRA needs > 22.5 GB on a 24 GB card}"
: "${RSP_EXPECT_WSL:=1}"                 # WSL2 path (00_check_system.sh warns if WSL is NOT detected)
