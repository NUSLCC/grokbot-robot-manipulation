# Hardware profile: lcc-TRX40 workstation - 2x RTX 3090 24 GB (Ampere, sm_86), native Ubuntu 22.04 (not WSL),
# NVIDIA driver 595, 125 GB RAM, Isaac Sim 6.2.0 + Isaac Lab 3.0.0 pre-installed. Uses the same torch/CUDA choices as PR #1.
# Auto-selected when the first GPU name contains "3090". Override with PROFILE=<name>. Any variable you export wins.
: "${RSP_PROFILE_DESC:=2x RTX 3090 24 GB (Ampere sm_86), native Ubuntu 22.04, driver 595}"
: "${RSP_EXPECT_GPUS:=2}"
: "${RSP_VRAM_CLASS_GB:=24}"
: "${RSP_GPU_ARCH:=ampere}"
: "${TORCH_CUDA:=cu128}"                 # PR #1 choice (LeRobot/ManiSkill cu128); other frameworks keep their own pins
: "${RSP_WSL_RENDER_FALLBACK:=1}"        # only matters if MuJoCo EGL fails; native Linux normally has NVIDIA EGL
: "${RSP_PI0_LORA_NOTE:=tight: openpi README says LoRA needs > 22.5 GB on a 24 GB card}"
: "${RSP_EXPECT_WSL:=0}"                 # native Linux path (00_check_system.sh warns if WSL is detected)
