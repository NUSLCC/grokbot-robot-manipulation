# Version pins for robot-sim-platform. Researched 2026-10-29 against official repos/docs.
# "verified" = taken from an official README/pyproject/tag list on that date.
# Override any value by exporting it before running a script.

# ---- LeRobot (ACT, Diffusion Policy, SmolVLA, pi0/pi0.5 ports, GR00T N1.7 port) ----
: "${LEROBOT_REF:=v0.6.1}"            # verified: latest git tag + latest PyPI release (main = 0.6.2.dev)
: "${LEROBOT_PY:=3.12}"               # verified: requires-python >=3.12
: "${LEROBOT_TORCH_BACKEND:=${TORCH_CUDA:-cu128}}"   # TORCH_CUDA comes from the hardware profile (cu128 everywhere today). verified: uv source install pins torch to cu128 index (driver floor 570.86)
: "${LEROBOT_EXTRAS:=training,libero,smolvla,pi,diffusion,aloha,pusht}"

# ---- openpi (pi0 / pi0-FAST / pi0.5, JAX + PyTorch) ----
: "${OPENPI_REF:=main}"               # repo has no release tags; script records the commit it used
# verified from pyproject: python>=3.11, jax[cuda12]==0.5.3, torch==2.7.1, transformers==4.53.2
# LIBERO client: python 3.8 venv + torch cu113 (verified, examples/libero/README.md)

# ---- OpenVLA-OFT ----
: "${OFT_REF:=main}"                  # no tags
: "${OFT_PY:=3.10}"                   # verified SETUP.md (paper used 3.10.14)
: "${OFT_FLASH_ATTN:=2.5.5}"          # verified SETUP.md
# torch==2.2.0 / torchvision==0.17.0 / torchaudio==2.2.0 + transformers fork are pinned by its pyproject (verified)

# ---- NVIDIA Isaac GR00T N1.7 ----
: "${GROOT_REF:=n1.7-release}"        # verified tag
: "${GROOT_PY:=3.12}"                 # verified (dGPU: CUDA 12.8 + Python 3.12)

# ---- Simulators / benchmarks ----
: "${LIBERO_REF:=master}"
: "${MANISKILL_VERSION:=3.0.1}"       # verified: PyPI latest + git tag v3.0.1
: "${MANISKILL_PY:=3.11}"             # requires-python >=3.9; 3.11 chosen by us (not an official pin)
: "${SIMPLER_REF:=main}"
: "${SIMPLER_PY:=3.10}"               # verified README (3.10 or 3.11)
: "${SIMPLER_NUMPY:=1.24.4}"          # verified README
: "${ROBOTWIN_REF:=main}"             # RoboTwin 2.0 lives on main (verified)
: "${ROBOTWIN_PY:=3.10}"              # verified install doc (CUDA 12.1 recommended)

# ---- RL fine-tuning ----
: "${RLINF_REF:=v0.4}"                # verified latest tag
: "${RLINF_DOCKER_IMAGE:=rlinf/rlinf:agentic-rlinf0.4-maniskill_libero}"  # verified install doc
: "${SIMPLEVLA_REF:=main}"
: "${SIMPLEVLA_TORCH:=2.4.0}"         # verified SETUP.md (cu124)
: "${VERL_BRANCH:=v0.2.x}"            # verified SETUP.md

# ---- Isaac (pre-installed on the workstation; NEVER installed by this kit) ----
: "${EXPECTED_ISAACLAB_VERSION:=3.0.0}"
: "${EXPECTED_ISAACSIM_VERSION:=6.2.0}"
# verified from IsaacLab release/3.0.0 pyproject: python >=3.12,<3.13, torch==2.11.0 (cu130 index),
# transformers==5.10.4, warp-lang==1.17.0, rsl-rl-lib==5.5.1, isaacsim[all,extscache]==6.2.0.0
: "${ISAACLAB_ARENA_REF:=main}"       # Arena v0.3.x is alpha; main targets Isaac Lab 3.0 (verified README)

# ---- Driver floors (verified) ----
: "${DRIVER_MIN_CU128:=570.86}"       # LeRobot docs
: "${DRIVER_MIN_CU130:=580.65}"       # LeRobot docs (PyPI cu130 torch)
: "${DRIVER_TESTED_ISAAC:=595.58.03}" # Isaac Sim 6.2 / Isaac Lab 3.0 requirement table

# ---- Blackwell (RTX 5090 Laptop, sm_120) ----
# Blackwell needs torch >= 2.7 built for CUDA >= 12.8. TORCH_CUDA (profile/auto) picks the wheel index for
# LeRobot and ManiSkill. Optional experimental overrides for frameworks that pin older torch:
: "${OFT_BLACKWELL_TORCH:=2.7.1}"     # used only with OFT_TORCH_OVERRIDE=1 (torch 2.7.1+cu128 wheels exist for cp310)
: "${OFT_BLACKWELL_TORCHVISION:=0.22.1}"
: "${OFT_BLACKWELL_TORCHAUDIO:=2.7.1}"
: "${OPENPI_TORCH_VERSION:=2.7.1}"    # openpi pin; cu128 variant installed only with OPENPI_TORCH_CU128=1
